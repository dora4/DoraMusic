<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/colorPanelBg">

        <View
            android:id="@+id/statusbar_player_bg_select"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/skin_theme_color" />

        <dora.widget.DoraTitleBar
            android:id="@+id/titlebar_player_bg_select"
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_bar_height"
            app:dview_title="@string/player_bg"
            app:dview_titleTextSize="@dimen/title_bar_text_size"
            app:dview_backIcon="@drawable/ic_back"
            app:dview_backIconTint="@color/white"
            app:dview_backIconSize="@dimen/title_bar_icon_size"
            android:background="@color/skin_theme_color" />

        <dora.widget.DoraTabBar
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPanelFg"
            android:paddingVertical="10dp"
            app:dview_tb_tabIsDivided="false"
            app:dview_tb_tabTextSize="16sp"
            app:dview_tb_tabUnselectedTextColor="@color/colorTextSecondary"
            app:dview_tb_tabSelectedTextColor="@color/skin_theme_color"
            app:dview_tb_indicatorType="NORMAL"
            app:dview_tb_indicatorColor="@color/skin_theme_color"
            app:dview_tb_tabPadding="15dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/divider_color"/>

        <!-- ViewPager2 模式容器 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- dview TabLayoutActivity风格：Fragment切换容器，默认隐藏 -->
        <FrameLayout
            android:id="@+id/flFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"/>

    </LinearLayout>
</layout>

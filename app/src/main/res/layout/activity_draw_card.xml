<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".score.DrawCardActivity">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorPanelFg"
        android:orientation="vertical">

        <View
            android:id="@+id/statusbar_draw_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/skin_theme_color" />

        <dora.widget.DoraTitleBar
            android:id="@+id/titlebar_draw_card"
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_bar_height"
            android:background="@color/skin_theme_color"
            app:dview_backIcon="@drawable/ic_back"
            app:dview_backIconSize="@dimen/title_bar_icon_size"
            app:dview_backIconTint="@color/white"
            app:dview_title="@string/draw_cards_to_collect_gallery"
            app:dview_titleTextSize="@dimen/title_bar_text_size" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGalleryName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/draw_card_primary_text_size" />

                <TextView
                    android:id="@+id/tvMyPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="6dp"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/draw_card_secondary_text_size" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/btnDrawCard"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/draw_card_card_btn_height"
                    android:background="@color/skin_theme_color"
                    android:layout_marginTop="20dp"
                    android:text="@string/draw_card_btn_text"
                    android:textSize="@dimen/draw_card_card_btn_text_size"
                    android:textColor="@color/white" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</layout>
